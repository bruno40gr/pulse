{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/academy-family-preview": ["/Users/brunowong/pulse-odeon-integration/lib/academy-family-preview"],
      "@/lib/academy-makeup-preview": ["/Users/brunowong/pulse-odeon-integration/lib/academy-makeup-preview"],
      "@/lib/academy-parent-portal": ["/Users/brunowong/pulse-odeon-integration/lib/academy-parent-portal"],
      "@/lib/academy-student-preview": ["/Users/brunowong/pulse-odeon-integration/lib/academy-student-preview"],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "fixtures/**/*.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
